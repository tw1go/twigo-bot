# Caddy config for the Mikazuki server. Replace twigo-bot.duckdns.org if the domain changes.
#   /play/*  → the web game's static files (built by deploy.sh into /opt/twigo-bot/web/play)
#   anything else → the bot's room API on 127.0.0.1:8787 (GET /leaderboard, POST /find, GET /health)
twigo-bot.duckdns.org {
	encode zstd gzip

	redir /play /play/ 308
	handle_path /play/* {
		root * /opt/twigo-bot/web/play
		# Only files whose names carry a content hash (Vite's bundle, the packed art sheets) are cached for good.
		# Everything else (index.html, manifest.json, town.json, loose images, the font) is revalidated on each
		# visit, so a deploy reaches returning players (unchanged files answer 304).
		@hashed path /assets/index-* /assets/packs/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/index-* /assets/packs/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}
