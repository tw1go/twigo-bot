# Caddy config for the Mikazuki server (Caddy gets the HTTPS certificates itself).
#   twigo.dev            the web game and its API: / → /play/, /play/* → the game's static files (built by deploy.sh
#                        into /opt/twigo-bot/web/play), anything else → the bot on 127.0.0.1:8787
#   www.twigo.dev        → twigo.dev
#   twigo-bot.duckdns.org the old address: the room API that tw1go.github.io calls (GET /leaderboard, POST /find,
#                        GET /health) stays; everything else (the game, login) moves to twigo.dev, because the bot
#                        only takes the game's requests from WEB_PUBLIC_URL.
twigo.dev {
	encode zstd gzip

	redir / /play/ 308
	redir /play /play/ 308
	# The tab icon at the root too (asked for by browsers on pages that don't link one, e.g. /health).
	handle /favicon.ico {
		root * /opt/twigo-bot/web/play
		file_server
	}
	handle_path /play/* {
		root * /opt/twigo-bot/web/play
		# Only files whose names carry a content hash (Vite's bundle, the packed art sheets) are cached for good.
		# Everything else (index.html, manifest.json, town.json, loose images, the font) is revalidated on each
		# visit, so a deploy reaches returning players (unchanged files answer 304).
		@hashed path /assets/index-* /assets/packs/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/index-* /assets/packs/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

www.twigo.dev {
	redir https://twigo.dev{uri} 308
}

twigo-bot.duckdns.org {
	encode zstd gzip

	@room path /leaderboard /find /health
	handle @room {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		redir https://twigo.dev{uri} 308
	}
}
