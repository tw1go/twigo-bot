# Caddy config for the Mikazuki server (Caddy gets the HTTPS certificates itself).
#   twigo.dev            the front page and the web game: / → the front page (the game build's front.html),
#                        /play/* → the game's static files (built by deploy.sh into /opt/twigo-bot/web/play; the front
#                        page's images and script are there too), /downloads/* → the desktop app's installers
#                        (/opt/twigo-bot/web/downloads, by hand), anything else → the bot on 127.0.0.1:8787
#   www.twigo.dev        → twigo.dev
#   twigo-bot.duckdns.org the old address: the room API that tw1go.github.io calls (GET /leaderboard, POST /find,
#                        GET /health) stays; everything else (the game, login) moves to twigo.dev, because the bot
#                        only takes the game's requests from WEB_PUBLIC_URL.
twigo.dev {
	encode zstd gzip

	redir /play /play/ 308
	# The front page: one HTML file of the game's build, revalidated on each visit like the game's index.html.
	handle / {
		root * /opt/twigo-bot/web/play
		rewrite * /front.html
		header Cache-Control "no-cache"
		file_server
	}
	# The tab icon at the root too (asked for by browsers on pages that don't link one, e.g. /health).
	handle /favicon.ico {
		root * /opt/twigo-bot/web/play
		file_server
	}
	handle_path /play/* {
		root * /opt/twigo-bot/web/play
		# Only files whose names carry a content hash (Vite's bundle: assets/play-*.js, kit-art-*.js, front-*.js and
		# their CSS, the only scripts and stylesheets directly in assets/; the packed art sheets) are cached for good.
		# Everything else (index.html, sw.js, manifest.json, town.json, loose images, the font) is revalidated on each
		# visit, so a deploy reaches returning players (unchanged files answer 304) and the home screen app's service
		# worker picks it up.
		# A file under assets/ that isn't there (an older build's art sheet, gone with a deploy) is a plain 404, never
		# kept: answering it with index.html, cached for good, left a game on an old build without that art for a year.
		@missing {
			path /assets/*
			not file
		}
		handle @missing {
			header Cache-Control "no-store"
			respond 404
		}
		handle {
			@hashed path /assets/index-* /assets/packs/* /assets/*.js /assets/*.css
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			@fresh not path /assets/index-* /assets/packs/* /assets/*.js /assets/*.css
			header @fresh Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	# The desktop app's installers and latest.json ({ version, windows, mac, windowsSize, macSize }): put there by hand,
	# in /opt/twigo-bot/web/downloads (deploys never touch it). latest.json is asked again each time (the front page and
	# the app read it; the app from its own origin, so it may be read from anywhere); installers are plain files.
	handle_path /downloads/* {
		root * /opt/twigo-bot/web/downloads
		@latest path /latest.json
		header @latest Cache-Control "no-cache"
		header @latest Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

www.twigo.dev {
	redir https://twigo.dev{uri} 308
}

twigo-bot.duckdns.org {
	encode zstd gzip

	@room path /leaderboard /find /health
	handle @room {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		redir https://twigo.dev{uri} 308
	}
}
