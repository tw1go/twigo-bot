{
  "name": "@mikazuki/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mikazuki web town (Phaser + Vite), served at /play",
  "scripts": {
    "dev": "npm run build -w @mikazuki/shared && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@mikazuki/shared": "0.1.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
