{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikazuki",
  "version": "0.1.0",
  "identifier": "dev.twigo.mikazuki",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": { "script": "npm run dev:game", "cwd": "../.." },
    "beforeBuildCommand": "node scripts/stage.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mikazuki",
        "url": "play/index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#1a1b26",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "RolePlayingGame",
    "shortDescription": "Mikazuki, the Mikazuki Discord server's town",
    "copyright": "twigo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["mikazuki"] } }
  }
}
