{
  "name": "@mikazuki/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-guard.mjs && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node scripts/local-guard.mjs && node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@mikazuki/shared": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
