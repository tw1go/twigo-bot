# From https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild instantly (for dev). Leave empty for global.
DISCORD_GUILD_ID=

# IANA timezone all schedule times are in, e.g. Asia/Manila, Europe/London, America/New_York
TIMEZONE=
# Role pinged on Saturday and allowed to answer the "match tonight?" question
ADMIN_ROLE_ID=
# Channel where the admin question is posted (can be a private admin channel)
ADMIN_CHANNEL_ID=
# Channel where the poll, participant list and reminder are posted
MATCH_CHANNEL_ID=
# Channel for Mine Wars reminders
MINE_WARS_CHANNEL_ID=
# Role pinged for Mine Wars; members toggle it with a button
MINE_WARS_ROLE_ID=
# Channel for the daily 7:00 AM greeting
GREETINGS_CHANNEL_ID=
# Channel where the bot randomly chats a few times a day
BANTER_CHANNEL_ID=
# Channel for Tanod Patrol and jackpot draws
GAMES_CHANNEL_ID=
# Where the bot posts about digs (the town's dig reveals, big /dig finds). Leave empty for the games channel.
DIG_CHANNEL_ID=
# Role given to jailed members (/jail, failed /steal, busted /gamble)
JAIL_ROLE_ID=
# User pinged when someone redeems a reward (they deliver it manually)
REWARD_OWNER_ID=
# Channel for boost thank-yous and the monthly booster payday
BOOST_CHANNEL_ID=
# Easter egg: reacting to this message once gives a one-time reward
EASTER_EGG_CHANNEL_ID=
EASTER_EGG_MESSAGE_ID=
# Optional: Discord login for the web game (/play). The OAuth2 client secret (Developer Portal → OAuth2) — keep it
# secret — and the public HTTPS address. Add <WEB_PUBLIC_URL>/auth/callback as a redirect in the Developer Portal.
DISCORD_CLIENT_SECRET=
WEB_PUBLIC_URL=https://twigo-bot.duckdns.org
# Local port for the twigo's-room API (leaderboard + Kowen finds), behind Caddy. Empty = off.
WEB_PORT=8787
# Optional: before launch, only members with this role (plus mods and admins) may play the web town. Empty = only
# mods and admins. After /gift launch everyone in the server may.
GAME_TESTER_ROLE_ID=
# Optional: the Discord channel linked to the web town's chat (messages go both ways). Reading that channel needs
# the Message Content intent: switch it on in the Developer Portal (Bot → Privileged Gateway Intents) BEFORE
# setting this, or the bot can't log in. Empty = the town chat stays in town.
TOWN_CHAT_CHANNEL_ID=
# /gamble is safer here (lower bust chance); anywhere else the Tanod busts more often
GAMBLING_CHANNEL_ID=
# Where twigo's room finds (/claim) are announced
ROOM_FINDS_CHANNEL_ID=

# ── Local development only (not needed on the server) ──
# The bot refuses to start locally unless this is 1 (the live bot runs on the server).
# ALLOW_LOCAL_BOT=1
# Where state and secrets live defaults to <repo root>/data and <repo root>/.env. To override, set DATA_DIR /
# ENV_FILE as environment variables when starting the bot (not in this file). The server's systemd unit sets both.
# Optional: off-server backups. An Oracle Object Storage pre-authenticated request URL for a bucket, with
# "Permit object writes" only (ends in /o/). Keep it secret. Empty = backups stay on the server only.
BACKUP_UPLOAD_URL=
