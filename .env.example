# From https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild instantly (for dev). Leave empty for global.
DISCORD_GUILD_ID=

# IANA timezone all schedule times are in, e.g. Asia/Manila, Europe/London, America/New_York
TIMEZONE=
# Role pinged on Saturday and allowed to answer the "match tonight?" question
ADMIN_ROLE_ID=
# Channel where the admin question is posted (can be a private admin channel)
ADMIN_CHANNEL_ID=
# Channel where the poll, participant list and reminder are posted
MATCH_CHANNEL_ID=
# Channel for Mine Wars reminders
MINE_WARS_CHANNEL_ID=
# Role pinged for Mine Wars; members toggle it with a button
MINE_WARS_ROLE_ID=
# Channel for the daily 7:00 AM greeting
GREETINGS_CHANNEL_ID=
